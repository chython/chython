<?xml version="1.0" encoding="UTF-8"?>
<!-- Marvin-flavoured CML, in the spelling an 11.8 MB ChemAxon export actually uses:
     convention="convention:molecular", the marvinDictRef namespace declared and never
     used, id="mN"/"aN"/"bN", atomRefs2, order="A" for an aromatic bond, and bondStereo
     as bare element text. In that export bondStereo appeared 5448 times - W 1068,
     H 929, C 405, T 287 - and atomRefs4 appeared zero times, which is why the C/T
     forms below carry no reference quadruple. Public compounds only.

     Four molecules, one construct each:
       m1  (E)-cinnamic acid  - order="A" ring, and a bare <bondStereo>T</bondStereo>
                                 that AGREES with the zig-zag drawing, so it is checked
                                 and nothing is logged
       m2  benzoate anion     - formalCharge="-1", hydrogenCount on the aromatic CH's
       m3  but-2-ene          - convention="MDL" conventionValue="3", "cis or trans,
                                 unknown which": a real construct with no field in the
                                 arena, so it must be logged unsupported
       m4  alanine            - convention="MDL" conventionValue="4", the either-wedge -->
<cml xmlns="http://www.xml-cml.org/schema" xmlns:convention="http://www.xml-cml.org/convention"
     convention="convention:molecular"
     xmlns:marvin="http://www.chemaxon.com/marvin/marvinDictRef"
     version="ChemAxon file format v16.02.15, generated by v21.15.0">
