# Two records in one file, demonstrating multi-record MOL2 support.
# Record 1: methane (C.3, sp3)
# Record 2: formaldehyde (C.2, O.2, sp2)
@<TRIPOS>MOLECULE
methane
 1 0 0 0 0
SMALL
NO_CHARGES

@<TRIPOS>ATOM
      1 C1          0.0000    0.0000    0.0000 C.3     1 LIG 0.000
@<TRIPOS>BOND
@<TRIPOS>MOLECULE
formaldehyde
 3 2 0 0 0
SMALL
NO_CHARGES

@<TRIPOS>ATOM
      1 C1          0.0000    0.0000    0.0000 C.2     1 LIG 0.000
      2 O1          1.2000    0.0000    0.0000 O.2     1 LIG 0.000
      3 H1         -0.5400    0.9400    0.0000 H       1 LIG 0.000
@<TRIPOS>BOND
     1     1     2    2
     2     1     3    1
