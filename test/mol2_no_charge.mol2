# Ethanol without a charge column in the ATOM block.
# Demonstrates: the charge column is optional; absent charge is stored as zero.
@<TRIPOS>MOLECULE
ethanol
 9 8 0 0 0
SMALL
NO_CHARGES

@<TRIPOS>ATOM
      1 C1          0.0000    0.0000    0.0000 C.3     1 LIG
      2 C2          1.5200    0.0000    0.0000 C.3     1 LIG
      3 O1          2.0800    1.1800    0.0000 O.3     1 LIG
      4 H1         -0.3700    1.0300    0.0000 H       1 LIG
      5 H2         -0.3700   -0.5200    0.8900 H       1 LIG
      6 H3         -0.3700   -0.5200   -0.8900 H       1 LIG
      7 H4          1.8900   -1.0300    0.0000 H       1 LIG
      8 H5          1.8900    0.5200    0.8900 H       1 LIG
      9 H6          2.0100    1.6200    0.8100 H       1 LIG
@<TRIPOS>BOND
     1     1     2    1
     2     2     3    1
     3     1     4    1
     4     1     5    1
     5     1     6    1
     6     2     7    1
     7     2     8    1
     8     3     9    1
