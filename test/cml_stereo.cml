<?xml version="1.0" encoding="UTF-8"?>
<!-- The CML half of an equivalence pair with test/cml_stereo.mol: alanine, drawn once.
     Same six atoms in the same order, same coordinates, and the wedge that the molfile
     spells as bond-block stereo 1 spelled here as <bondStereo>W</bondStereo>. The point
     of the pair is that the two readers must agree on the configuration, which is what
     routing CML through the CTfile reader's own Ctab is for.
     Written in ChemAxon's observed spelling: convention="convention:molecular", the
     marvinDictRef namespace declared and unused, id="mN"/"aN"/"bN", atomRefs2. -->
<cml xmlns="http://www.xml-cml.org/schema" xmlns:convention="http://www.xml-cml.org/convention"
     convention="convention:molecular"
     xmlns:marvin="http://www.chemaxon.com/marvin/marvinDictRef"
     version="ChemAxon file format v16.02.15, generated by v21.15.0">
  <molecule id="m1">
    <name>alanine-wedge</name>
    <atomArray>
      <atom id="a1" elementType="C" x2="0.0000" y2="0.0000"/>
      <atom id="a2" elementType="N" x2="-0.8700" y2="0.5000"/>
      <atom id="a3" elementType="C" x2="0.0000" y2="-1.0000"/>
      <atom id="a4" elementType="C" x2="0.8700" y2="0.5000"/>
      <atom id="a5" elementType="O" x2="1.7300" y2="0.0000"/>
      <atom id="a6" elementType="O" x2="0.8700" y2="1.5000"/>
    </atomArray>
    <bondArray>
      <bond id="b1" atomRefs2="a1 a2" order="1"><bondStereo>W</bondStereo></bond>
      <bond id="b2" atomRefs2="a1 a3" order="1"/>
      <bond id="b3" atomRefs2="a1 a4" order="1"/>
      <bond id="b4" atomRefs2="a4 a5" order="2"/>
      <bond id="b5" atomRefs2="a4 a6" order="1"/>
    </bondArray>
  </molecule>
</cml>
